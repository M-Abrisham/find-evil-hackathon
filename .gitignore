# --- Secrets / credentials (never commit) ---
.env
*.env
*.pem
*.key
*_token
*secret*
.aws/
.config/gh/
settings.local.json
**/.claude/settings.local.json

# --- Forensic evidence / case data (never commit raw evidence) ---
evidence/
cases/
*.E01
*.dd
*.raw
*.img
*.vmem
*.mem
*.dmp
*.aff4
*.lime

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Tool output ---
runs/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Runtime score ledger (per-lap KEEP/REVERT record) — commit CODE only ---
# The hash-chained ledger.jsonl is a runtime artifact (like receipts.jsonl);
# only the score_ledger.py CODE is committed, never the data.
ledger.jsonl
*.ledger.jsonl
_demo.ledger.jsonl
_demo_candidate_agg.json
